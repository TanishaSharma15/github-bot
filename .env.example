# Copy this file to .env and fill in the GitHub values.
# The app reads .env on startup. Do not commit .env.
# Local database defaults match docker-compose.yml.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/githubbot
SPRING_DATASOURCE_USERNAME=githubbot
SPRING_DATASOURCE_PASSWORD=githubbot

# Filled in when GitHub sign-in is added. Leave these empty in this example file.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APP_BASE_URL=http://localhost:8080
APP_ENCRYPTION_KEY=
SESSION_SECRET=

# Optional. A free Groq key adds a short summary to the Slack message.
GROQ_API_KEY=
